# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# In production, set these as real environment variables (systemd/gunicorn/EC2).
# All values below are placeholders — NONE are real secrets.

# Django
DJANGO_SECRET_KEY=generate-a-new-50+-char-random-key

# PostgreSQL database
DB_NAME=usiku_beats_database
DB_USER=your_db_user
DB_PASSWORD=your_new_rotated_db_password
DB_HOST=localhost
DB_PORT=5432

# Xsolla payment provider
XSOLLA_WEBHOOK_SECRET_KEY=your_rotated_xsolla_webhook_secret
XSOLLA_API_KEY=your_rotated_xsolla_api_key
# Non-secret identifiers (override only if they change):
XSOLLA_PROJECT_ID=292524
XSOLLA_MERCHANT_ID=836727
